# Resend API Key for sending email notifications
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Contraseña del panel privado (/panel). Definir también en Vercel.
# Elige una contraseña larga y única; con esta se accede al dashboard.
PANEL_PASSWORD=cambia_esta_contrasena

# API key de Windsor.ai para datos en vivo de redes (FB, IG, YouTube, TikTok).
# Se obtiene en el panel de Windsor.ai → API. Definir en Vercel.
# Sin esta variable, el panel usa los datos manuales de lib/dashboardData.ts.
WINDSOR_API_KEY=tu_api_key_de_windsor
